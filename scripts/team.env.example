# Unified server-only configuration. Copy outside the repository:
# %USERPROFILE%/LernyPrivateData/secrets/team.env
# LERNY_ENV_FILE selects another private file. Never use VITE_* for secrets.
# Blank entries keep existing settings. Process environment overrides file values.

# Gemini: separate keys, or the same key in both fields.
GEMINI_EMBEDDING_API_KEY=
GEMINI_CONTENT_API_KEY=
GEMINI_CONTENT_MODEL=gemini-3.5-flash-lite
# Server-wide ceilings. Every worker/key for one Google project uses the same label.
# These are conservative application settings, not verified Google project quotas.
LERNY_GEMINI_QUOTA_PROJECT=lerny
LERNY_GEMINI_CONTENT_REQUESTS_PER_MINUTE=12
LERNY_GEMINI_EMBEDDING_REQUESTS_PER_MINUTE=12
LERNY_GEMINI_CONTENT_TOKENS_PER_MINUTE=200000
LERNY_GEMINI_EMBEDDING_TOKENS_PER_MINUTE=200000
# Set after checking AI Studio. Zero uses provider Retry-After/daily reset responses.
LERNY_GEMINI_CONTENT_REQUESTS_PER_DAY=0
LERNY_GEMINI_EMBEDDING_REQUESTS_PER_DAY=0
# Optional shared key fallback when a purpose-specific key is empty.
GEMINI_API_KEY=
# Embedding model is fixed to gemini-embedding-2 (768 dimensions).
# Changing it requires an adapter change and reindexing; no env switch is exposed.

# HeyGen: API secret plus avatar/voice IDs (IDs are not API keys).
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Supabase / database: server-only. DATABASE_URL includes the database password.
# Paste the project's PostgreSQL URI and URI-encode reserved password characters.
# Shared development uses the same Supabase DB. Tests must use a separate local DB.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
LERNY_STORAGE_BUCKET=lerny-materials
# Original uploads and downloads use the private shared bucket, independent of compute.
LERNY_FILE_STORAGE=supabase
# Shared Gemini vectors in Supabase; local keeps the original file-based index.
LERNY_RAG_STORAGE=supabase
# transaction for a Supabase transaction pooler; session for local PostgreSQL.
LERNY_DATABASE_POOL_MODE=

# Vercel automation only. Optional with Git deployment or an existing CLI login.
# python scripts/run_vercel.py <arguments> reads only these three entries.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Existing cloud queue/scheduler only: two different random secrets (32+ characters).
LERNY_AI_WORKER_TOKEN=
CRON_SECRET=
# Deployment origin/cookies/mode belong to each target environment.
# Start-Team keeps Gemini calls OFF unless the user passes -EnableApiCalls.

# Administrator console (server-only; never VITE_*).
# A stable Fernet key generated once and backed up securely; do not rotate blindly.
LERNY_ADMIN_MFA_KEY=
# Enable only after the authenticated control function, workers, and scheduler are verified.
LERNY_ADMIN_SERVER_ENABLED=false
LERNY_ADMIN_AWS_REGION=ap-southeast-2
LERNY_ADMIN_AWS_ACCOUNT=604472166923
# Set the same target on the API and dedicated EC2 workers for readiness checks.
LERNY_ADMIN_INSTANCE_ID=i-0c64182a7dada987a
# Production Lambda URL; a verified Vercel OIDC token is sent server-to-server.
LERNY_ADMIN_CONTROL_URL=
# Optional direct STS role for projects supporting IAM OIDC providers. Unused here.
LERNY_ADMIN_AWS_ROLE_ARN=
