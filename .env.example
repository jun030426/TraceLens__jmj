# 프론트엔드 환경 변수 예시 — 이 파일을 복사해서 .env (또는 .env.local) 로 만들어 쓰세요.
#
# ⚠️ VITE_ 로 시작하는 값은 브라우저에 그대로 노출돼요.
#    AI 서버 주소, DB 비밀번호, 비밀 키 같은 값은 절대 여기 넣지 말고 백엔드 서버에만 두세요.
#    (이 프로젝트는 프론트 → 우리 백엔드 → 우리 AI 서버 구조라서 프론트에는 비밀 값이 필요 없어요)

# API 주소 앞부분. 프론트와 백엔드를 같은 도메인으로 배포하면 '/api' 그대로 두면 돼요.
# 다른 도메인이면 전체 주소를 적어요 (예: https://api.lerny.example.com/api) — 이때 백엔드 CORS 설정 필요
VITE_API_BASE_URL=/api

# true  = 서버 없이 화면 확인용 임시 데이터 사용
# false = 실제 백엔드 서버 호출
VITE_USE_MOCK=true

# (개발용) npm run dev 할 때 /api 요청을 넘겨줄 백엔드 서버 주소 — vite.config.ts 에서 사용
DEV_API_PROXY_TARGET=http://localhost:8080
