# Server-only Vercel Production variables. Never prefix secrets with VITE_.
LERNY_DEPLOYMENT=cloud
LERNY_DATABASE_URL=postgresql+psycopg://postgres.PROJECT:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
LERNY_DATABASE_POOL_MODE=transaction
LERNY_ALLOWED_ORIGINS=["https://YOUR_PROJECT.vercel.app"]
LERNY_COOKIE_SECURE=true
LERNY_SUPABASE_URL=https://PROJECT.supabase.co
LERNY_SUPABASE_SERVICE_KEY=SET_IN_VERCEL_ONLY
LERNY_STORAGE_BUCKET=lerny-materials
LERNY_AI_WORKER_TOKEN=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CRON_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
LERNY_MODEL_NAME=qwen3:4b-instruct
