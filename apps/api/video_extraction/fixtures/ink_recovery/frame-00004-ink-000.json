      "asr_context": [
        {
          "id": "asr-0000-0011",
          "start_seconds": 35.9,
          "end_seconds": 37.84,
          "text": "내가 매번 돌리잖아요 그러면"
        },
        {
          "id": "asr-0000-0012",
          "start_seconds": 37.84,
          "end_seconds": 40.32,
          "text": "그 데이터값들이 순서가 막 바뀌는게"
        },
        {
          "id": "asr-0000-0013",
          "start_seconds": 40.32,
          "end_seconds": 42.36,
          "text": "매번 바뀌어요 그러니까 요런 것들을"
        },
        {
          "id": "asr-0000-0014",
          "start_seconds": 42.36,
          "end_seconds": 44.32,
          "text": "여러분이 착각하시면 안되겠다"
        },
        {
          "id": "asr-0000-0015",
          "start_seconds": 44.32,
          "end_seconds": 46.62,
          "text": "뭔가 잘못된거 아니야 라고 생각하지 마시고"
        },
        {
          "id": "asr-0000-0016",
          "start_seconds": 46.62,
          "end_seconds": 48.26,
          "text": "셋이라고 하는 구조는"
        },
        {
          "id": "asr-0000-0017",
          "start_seconds": 48.26,
          "end_seconds": 49.1,
          "text": "순서가 없어서"
        },
        {
          "id": "asr-0000-0018",
          "start_seconds": 49.1,
          "end_seconds": 52.42,
          "text": "시스템에 의해서 자동으로 그 순서가"
        },
        {
          "id": "asr-0000-0019",
          "start_seconds": 52.42,
          "end_seconds": 54.48,
          "text": "막 바뀌어지고 있다라고 보시면 되겠습니다"
        },
        {
          "id": "asr-0000-0020",
          "start_seconds": 55.52,
          "end_seconds": 60.78,
          "text": "자 지금 보니까 배열 리스트에 초기화가 세팅이 되어 있어요."
        },
        {
          "id": "asr-0000-0021",
          "start_seconds": 61.32,
          "end_seconds": 66.2,
          "text": "그때 그 세팅되어 있는 데이터를 셋을 통해서 접근을 하면"
        }
      ],
      "speech_cue_hits": [
        "순서"
      ],
