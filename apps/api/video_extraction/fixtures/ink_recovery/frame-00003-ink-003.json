      "asr_context": [
        {
          "id": "asr-0000-0003",
          "start_seconds": 14.02,
          "end_seconds": 19.36,
          "text": "더불어서 공통되어 있는 데이터들은 삭제를 해준다고 이야기를 했었어요."
        },
        {
          "id": "asr-0000-0004",
          "start_seconds": 20.08,
          "end_seconds": 22.12,
          "text": "이러한 응용에 대한 문제들,"
        },
        {
          "id": "asr-0000-0005",
          "start_seconds": 22.26,
          "end_seconds": 25.78,
          "text": "집합은 순서가 없다고 하는 자료형이라는 것,"
        },
        {
          "id": "asr-0000-0006",
          "start_seconds": 27.06,
          "end_seconds": 27.86,
          "text": "더불어서"
        },
        {
          "id": "asr-0000-0007",
          "start_seconds": 27.86,
          "end_seconds": 29.74,
          "text": "출력되는 순서는"
        },
        {
          "id": "asr-0000-0008",
          "start_seconds": 29.74,
          "end_seconds": 31.98,
          "text": "실행 환경에 따라 달라질 수 있다"
        },
        {
          "id": "asr-0000-0009",
          "start_seconds": 31.98,
          "end_seconds": 34.02,
          "text": "라고 하는거 이거 얘기냐면 얘네들은"
        },
        {
          "id": "asr-0000-0010",
          "start_seconds": 34.02,
          "end_seconds": 35.9,
          "text": "순서가 없어서 그래요 그래서 프로그램 따라서"
        },
        {
          "id": "asr-0000-0011",
          "start_seconds": 35.9,
          "end_seconds": 37.84,
          "text": "내가 매번 돌리잖아요 그러면"
        },
        {
          "id": "asr-0000-0012",
          "start_seconds": 37.84,
          "end_seconds": 40.32,
          "text": "그 데이터값들이 순서가 막 바뀌는게"
        },
        {
          "id": "asr-0000-0013",
          "start_seconds": 40.32,
          "end_seconds": 42.36,
          "text": "매번 바뀌어요 그러니까 요런 것들을"
        },
        {
          "id": "asr-0000-0014",
          "start_seconds": 42.36,
          "end_seconds": 44.32,
          "text": "여러분이 착각하시면 안되겠다"
        },
        {
          "id": "asr-0000-0015",
          "start_seconds": 44.32,
          "end_seconds": 46.62,
          "text": "뭔가 잘못된거 아니야 라고 생각하지 마시고"
        }
      ],
      "speech_cue_hits": [
        "따라서",
        "순서"
      ],
