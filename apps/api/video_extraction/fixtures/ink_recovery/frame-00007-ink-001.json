      "asr_context": [
        {
          "id": "asr-0000-0030",
          "start_seconds": 93.06,
          "end_seconds": 97.32,
          "text": "다음과 같이 지금 보니까 애플, 바나나, 오렌지라고 지정이 되어 있죠?"
        },
        {
          "id": "asr-0000-0031",
          "start_seconds": 97.48,
          "end_seconds": 99.8,
          "text": "지금 보니까 중괄호로 만들어져 있어요."
        },
        {
          "id": "asr-0000-0032",
          "start_seconds": 100.24,
          "end_seconds": 103.28,
          "text": "근데 여기에 키와 밸류라고 하는 쌍으로 만들어져 있어요."
        },
        {
          "id": "asr-0000-0033",
          "start_seconds": 103.46,
          "end_seconds": 104.7,
          "text": "그러면 딕셔넬이 아니죠?"
        },
        {
          "id": "asr-0000-0034",
          "start_seconds": 105.16,
          "end_seconds": 107.46,
          "text": "그러면 중괄호를 쓸 수 있는 것 중에 하나 뭐가 있었더라?"
        },
        {
          "id": "asr-0000-0035",
          "start_seconds": 108.02,
          "end_seconds": 109.82,
          "text": "집합이 있었던 거 기억이 나시죠?"
        },
        {
          "id": "asr-0000-0036",
          "start_seconds": 110.3,
          "end_seconds": 115.24,
          "text": "가로는 튜플이다, 대가로는 뭐라고요? 리스트다 라고 얘기를 했었어요."
        },
        {
          "id": "asr-0000-0037",
          "start_seconds": 115.6,
          "end_seconds": 118.28,
          "text": "그래서 키와 값과 분리가 되어 있지 않았다."
        },
        {
          "id": "asr-0000-0038",
          "start_seconds": 118.46,
          "end_seconds": 122.78,
          "text": "그러면 얘네들은 멍인 거다, 집합이다 라고 하는 것을 알아야지만 됩니다."
        },
        {
          "id": "asr-0000-0039",
          "start_seconds": 123.5,
          "end_seconds": 127.9,
          "text": "자 그때 그 데이터 값을 객체를 불러가지고 와서"
        }
      ],
      "speech_cue_hits": [
        "기억",
        "다음",
        "여기"
