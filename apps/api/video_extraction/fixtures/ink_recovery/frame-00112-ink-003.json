      "asr_context": [
        {
          "id": "asr-0011-0009",
          "start_seconds": 2023.58,
          "end_seconds": 2026.24,
          "text": "서로 비교해 보시기를 바랍니다."
        },
        {
          "id": "asr-0011-0010",
          "start_seconds": 2028.06,
          "end_seconds": 2031.54,
          "text": "자 더불어 집합 구조라고 하는 것 얘는 중복을 허용하지 않았어요."
        },
        {
          "id": "asr-0011-0011",
          "start_seconds": 2031.54,
          "end_seconds": 2033.36,
          "text": "그래서 얘는 더불어 순서도 없고요."
        },
        {
          "id": "asr-0011-0012",
          "start_seconds": 2033.5,
          "end_seconds": 2034.78,
          "text": "인덱스 사용할 수가 없었어요."
        },
        {
          "id": "asr-0011-0013",
          "start_seconds": 2035.22,
          "end_seconds": 2037.4,
          "text": "자 여기서 사용할 수 있는 메소드가 뭐가 있었었나"
        },
        {
          "id": "asr-0011-0014",
          "start_seconds": 2037.4,
          "end_seconds": 2039.2,
          "text": "라고 하는 거 연산과 관련되어 있는"
        },
        {
          "id": "asr-0011-0015",
          "start_seconds": 2039.2,
          "end_seconds": 2041.48,
          "text": "마찬가지로 우리가 사용할 수 있는"
        },
        {
          "id": "asr-0011-0016",
          "start_seconds": 2041.48,
          "end_seconds": 2042.66,
          "text": "연산이 있었다는 거"
        },
        {
          "id": "asr-0011-0017",
          "start_seconds": 2042.66,
          "end_seconds": 2043.58,
          "text": "그 다음에"
        },
        {
          "id": "asr-0011-0018",
          "start_seconds": 2044.7,
          "end_seconds": 2047.14,
          "text": "데이터 중에서 중복을 제거하려면"
        },
        {
          "id": "asr-0011-0019",
          "start_seconds": 2047.14,
          "end_seconds": 2049.28,
          "text": "이 집합이라고 하는 자료 구조를 통하면"
        },
        {
          "id": "asr-0011-0020",
          "start_seconds": 2049.28,
          "end_seconds": 2051.62,
          "text": "조금 더 효율적으로 자료를 관리할 수"
        },
        {
          "id": "asr-0011-0021",
          "start_seconds": 2051.62,
          "end_seconds": 2052.74,
          "text": "있다라고 하는 거"
        }
      ],
      "speech_cue_hits": [
        "다음",
        "순서",
        "여기"
      ],
