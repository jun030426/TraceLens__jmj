[Unit]
Description=Lerny shared material processing worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/lerny/current/deploy/aws/start_worker.py material
Restart=always
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lerny-worker
PrivateTmp=true
LimitNOFILE=1024
MemoryMax=1400M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
